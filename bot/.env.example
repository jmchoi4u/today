# 오늘 비서 설정 (install.cmd가 이 파일을 .env로 만들어 줘요. 직접 고쳐도 돼요)
# 텔레그램 @BotFather에서 받은 봇 토큰
TELEGRAM_BOT_TOKEN=
# 기록 저장소 (비공개)와 그 저장소만 읽고 쓰는 GitHub 토큰 (Contents: Read and write)
GITHUB_REPO=jmchoi4u/today-data
GITHUB_TOKEN=
# AI: claude | gemini | none (none이면 규칙으로 알아듣는 말만 처리해요)
# claude: 유료(API 데이터는 학습에 안 씀). 모든 말을 AI가 먼저 읽고 오늘 상태·최근 대화를 같이 봐요 (두뇌 모드, 약 이름은 가려서 보냄)
# gemini: 무료 등급은 보낸 내용이 구글 제품 개선에 쓰일 수 있어서, 규칙으로 못 알아들은 말만 최소한으로 보내요
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
ANTHROPIC_API_KEY=
# claude-haiku-5-5: 월 몇천 원. claude-opus-5-5로 바꾸면 같은 사용량에 약 40배
CLAUDE_MODEL=claude-haiku-5-5
# 두뇌 모드를 직접 켜고 끄기 (비우면 claude일 때만 켜짐. 유료 Gemini면 1로)
LLM_FULL_CONTEXT=
# 일어났는지 물어보는 시각 (비우면 안 물어봐요)
WAKE_WEEKDAY=07:00
WAKE_WEEKEND=08:00
# 이 시간대엔 먼저 말 걸지 않아요
QUIET_FROM=01:00
QUIET_TO=06:30
# 새 버전 자동으로 받기 (off면 텔레그램에서 /update라고 할 때만)
AUTO_UPDATE=on
# 구글 캘린더 일정 읽기 (선택). 캘린더 설정 → 내 캘린더 → "iCal 형식의 비공개 주소"
# 이 주소를 아는 사람은 내 일정을 볼 수 있으니 어디에도 올리지 마세요
CALENDAR_ICS_URL=
# 앱 주소 (알림의 링크에 써요)
APP_URL=https://jmchoi4u.github.io/today/
