# 오늘 비서 설정 (install.cmd가 이 파일을 .env로 만들어 줘요. 직접 고쳐도 돼요)
# 텔레그램 @BotFather에서 받은 봇 토큰
TELEGRAM_BOT_TOKEN=
# 기록 저장소 (비공개)와 그 저장소만 읽고 쓰는 GitHub 토큰 (Contents: Read and write)
GITHUB_REPO=jmchoi4u/today-data
GITHUB_TOKEN=
# AI: gemini | claude | none (none이면 규칙으로 알아듣는 말만 처리해요)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
ANTHROPIC_API_KEY=
# 기본은 claude-opus-5-5. 비용을 줄이려면 claude-haiku-5-5
CLAUDE_MODEL=claude-opus-5-5
# 일어났는지 물어보는 시각 (비우면 안 물어봐요)
WAKE_WEEKDAY=07:00
WAKE_WEEKEND=08:00
# 이 시간대엔 먼저 말 걸지 않아요
QUIET_FROM=01:00
QUIET_TO=06:30
# 앱 주소 (알림의 링크에 써요)
APP_URL=https://jmchoi4u.github.io/today/
